<?xml version="1.1" encoding="UTF-8"?>

<!--
  QXDC: este arquivo NÃO define o wallpaper (backdrop).
  O wallpaper é aplicado dinamicamente pelo módulo 'desktop wallpaper'
  (modules/desktop/wallpaper.sh), que detecta os monitores conectados via
  xrandr e escreve as chaves /backdrop/screen0/monitor<NOME>/... corretas
  para cada máquina. Fixar monitores/caminhos aqui quebra em hardware
  diferente (ex.: eDP-1 vs HDMI-2 vs VGA-0), então mantemos apenas as
  preferências de ícones e menu da área de trabalho.
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="true"/>
    </property>
  </property>
  <property name="desktop-menu" type="empty">
    <property name="show" type="bool" value="false"/>
  </property>
</channel>
